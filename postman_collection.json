              "raw": "{\n  \"name\": \"Pain Leader\",\n  \"email\": \"pain@akatsuki.com\",\n  \"password\": \"admin12345\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register an admin user with role 'admin'."
          }
        },
